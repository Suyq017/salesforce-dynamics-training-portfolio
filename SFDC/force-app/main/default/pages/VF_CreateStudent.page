* @created： 2026/06/03 Nguyen Ngoc Quy
* @modified： 2026/06/05 Nguyen Ngoc Quy
-->
<apex:page controller="VF_CreateStudentCtrl">
    <apex:messages />
    <!-- Header -->
    <apex:sectionHeader title="新規学生" />
    <!-- Form -->
    <apex:form >
        <apex:pageBlock mode="edit">
            <apex:pageBlockSection columns="1">
                <apex:inputField value="{!student.LastName__c}" required="true"/>
                <apex:inputField value="{!student.FirstName__c}" required="true"/>
                <apex:inputField value="{!student.Birthday__c}" required="true"/>
                <apex:inputField value="{!student.Gender__c}" required="true"/>
                <apex:inputField value="{!student.Class_look__c}" required="true"/>
                <apex:inputField value="{!student.LearningStatus__c}" required="true"/>
                <apex:pageblockSectionItem >
                    <apex:outputPanel layout="none">
                        <apex:commandButton value="キャンセル" styleClass="close-button" action="{!returnToSearchPage}" immediate="true"/>
                        <apex:commandButton value="保存" styleClass="save-button" action="{!saveStudent}" />
                    </apex:outputPanel>
                </apex:pageblockSectionItem>
            </apex:pageBlockSection>
        </apex:pageBlock>
    </apex:form>
</apex:page>